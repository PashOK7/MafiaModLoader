{
  // The defaults of game_fixes' settings. Do not edit this file in the game's folder (a deploy replaces it): change
  // a setting with `config.set {"mod": "game_fixes", "key": "sniper_binding", "value": false}`, in Options > Mods >
  // Game fixes, or in <game>\mml\data\game_fixes\config.json, which holds the changes only. Each takes effect at once.
  "options_saved": true,    // 1.2: the options' details, draw distance, effects, sounds, shadows and particles written
                            // where the game reads them at its start (it wrote them where it never looks)
  "sniper_binding": true,   // 1.2: Sniper Mode's key kept when the profile loads (every load took it away)
  "key_names": true         // the controls' names of keys and joysticks the game's font cannot draw (a Russian layout's
                            // letters, a joystick's axes in the system's language) given in English
}
