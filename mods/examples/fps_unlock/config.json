{
  // The defaults of fps_unlock's settings. Do not edit this file in the game's folder (a deploy replaces it): change
  // a setting with `config.set {"mod": "fps_unlock", "key": "max_fps", "value": 144}`, or in
  // <game>\mml\data\fps_unlock\config.json, which holds the changes only. Both take effect at once.
  "enabled": true,   // the game's 62.5 fps limit taken away (false: the game's own pacing)
  "max_fps": 0,      // a cap of the mod's own, frames a second (0: none; the game's time stays real either way)
  "show": true,      // the line at the top left: frames a second, the frame's time, the game's clock step
  "fix_menu_camera": true,   // the main menu camera's spring stepped by the time, not once a frame (1.2)
  "hotkey": "F11"    // switches "enabled"
}
