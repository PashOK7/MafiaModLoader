{
  "id": "trigger_view",
  "name": "Trigger view: the mission scripts' triggers drawn in the world (detectors, their radii and use points, areas)",
  "version": "0.1.0",
  "type": "native",
  "entry": "trigger_view.dll",
  "enabled": false,
  "builds": ["1.2", "1.0"],
  "load_order": 100,
  "depends": [],
  "settings": {
    "title": "Trigger view",
    "controls": [
      {"key": "show", "label": "Shown"},
      {"key": "hotkey", "label": "Shown and hidden", "kind": "key"},
      {"key": "detectors", "label": "Detectors"},
      {"key": "inrange", "label": "Their ranges"},
      {"key": "use", "label": "Their use points"},
      {"key": "boxes", "label": "Their boxes"},
      {"key": "areas", "label": "Areas"},
      {"key": "range", "label": "Drawn within", "min": 20, "max": 500, "step": 10, "unit": "m"},
      {"key": "label_range", "label": "Labels within", "min": 5, "max": 200, "step": 5, "unit": "m"}
    ]
  }
}
