{
  // The defaults of debug_views, a section a view (Options > Mods > Debug views changes them in the game, a tab a
  // section; they are kept in <game>\mml\data\debug_views\config.json; `config.set {"mod": "debug_views", "key":
  // "routes.trail_s", "value": 5}` too). routes: whose routes are drawn (people, cars; the traffic's own cars off),
  // their parts (the route, where each is sent now, the way gone and for how long). triggers: the mission scripts'
  // detectors, areas and the distances they test. race: the race of mission 6 and the walls nothing draws there.
  // collision: the static world's whole collision by surface. web: the pedestrians' web. names: the actors' names.
  // Each view's key shows and hides it.
  "routes": {
    "show": true,
    "hotkey": "F6",
    "people": true,
    "cars": true,
    "traffic": false,
    "route": true,
    "steer": true,
    "trail": true,
    "trail_s": 10,
    "range": 150
  },
  "triggers": {
    "show": true,
    "hotkey": "F7",
    "detectors": true,
    "inrange": true,
    "use": true,
    "boxes": true,
    "areas": true,
    "distances": true,
    "range": 150,
    "label_range": 50
  },
  "race": {
    "show": true,
    "hotkey": "F8",
    "gates": true,
    "racers": true,
    "targets": true,
    "trace": false,
    "paint": true,
    "paint_width": 3,
    "zone_alpha": 0.1,
    "trail": true,
    "laps": true,
    "probe": true,
    "walls": true,
    "walls_range": 60,
    "walls_grid": 1,
    "walls_period": 8,
    "walls_strength": 1,
    "walls_color": "#4DD9FF",
    "range": 300,
    "label_range": 120
  },
  "collision": {
    "show": false,
    "hotkey": "Shift+F9",
    "range": 40,
    "fill": 0.6,
    "edges": true,
    "ao": 0.7,
    "grid": 1,
    "tolerance": 0.15,
    "moving": true,
    "people": true,
    "through": false,
    "labels": true,
    "label_range": 15
  },
  "web": {
    "show": false,
    "hotkey": "Shift+F6",
    "range": 80,
    "through": false,
    "labels": false,
    "label_range": 15
  },
  "names": {
    "show": false,
    "hotkey": "Shift+F8",
    "range": 40,
    "max": 60
  }
}
