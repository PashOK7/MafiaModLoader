{
  // The defaults of the telemetry mod's settings. Do not edit this file in the game's folder (a deploy replaces it):
  // change a setting with `config.set {"mod": "telemetry", "key": "units", "value": "mph"}` over the bridge, or in
  // <game>\mml\data\telemetry\config.json, which holds the changes only. Both are read again as they change.

  // Keys the game's own controls do not use by default (`call input.actions` lists what each action is bound to in
  // the profile: there F5 is the speed limiter and Tab the city map).
  "hotkey_lap": "F9",          // starts a lap here and now (modifiers: "Ctrl+F9", "Ctrl+Shift+L")
  "hotkey_repair": "F7",       // repairs the car and puts it on its wheels (the game's own car_repair)
  "hotkey_rival": "F6",        // a car made new 8 m in front (the one made before taken out)
  "rival_car": "Bolt-Thrower", // its model: a name of the game's car list (`call world.cars`) or a file ("fordttud00.i3d")
  "key_details": "F8",         // held: fuel, damage, the position
  "units": "kmh",              // "kmh" or "mph"

  // The overlay: its top left corner in the menus' 800x600 units, its size as a factor.
  "overlay": { "show": true, "x": 560, "y": 240, "scale": 1.0 },

  // The checkpoints: circles on the ground (world metres; y is up and not used). These two are for the default
  // freeride (missions\freeitaly): the start is where the taxi stands, the finish is 25 m ahead, across the street.
  // `telemetry.checkpoint {"which": "finish"}` puts one where the car is.
  "start":  { "x": -1984.9, "y": -4.9, "z": 23.1, "radius": 6 },
  "finish": { "x": -1985.0, "y": -4.9, "z": -2.0, "radius": 6 }
}
