{
  // The defaults of dlss_nr's settings (the game's Options > Mods > DLSS 5 NR, or
  // config.set {"mod": "dlss_nr", "key": "intensity", "value": 0.8}). The strengths are NVIDIA's own parameters of
  // DLSS 5 Neural Rendering (NGX's DLSSNR evaluation), with RTX Remix's defaults.
  "on": true,              // DLSS over the frame (the hotkey switches it and keeps the choice)
  "hotkey": "F12",         // on and off
  "nr": true,              // DLSS 5 Neural Rendering (a GeForce RTX 50 and nvngx_dlssnr.dll); off: Super Resolution alone
  "upscale": 2,            // DLSS Super Resolution (an RTX and nvngx_dlss.dll): 0 off, 1 DLAA, 2 Quality, 3 Balanced,
                           // 4 Performance, 5 Ultra Performance. The game draws its world at the mode's render size
                           // (Performance: a quarter of the pixels; the loader's gfx_upscale), DLSS-NR runs there, DLSS SR
                           // brings the picture to the frame's: the faster, the softer
  "pipeline": true,        // DLSS works on a frame while the game draws the next (the picture a frame behind); off:
                           // each frame waits for its own (the frame rate is DLSS's then)
  "frame_gen": 0,          // DLSS Frame Generation (an RTX 40 or newer and nvngx_dlssg.dll): the frames made between two,
                           // 0 off, 1 2x, 2 3x, 3 4x (3x and 4x: an RTX 50): the most made. The game always runs at
                           // its own rate; only as many are made as fit between two of its frames under the display's
                           // refresh (none when the game alone fills it), shown from the bridge's own thread, spaced
  "intensity": 1.0,        // InIntensity: how much of DLSS-NR's picture (0 the game's own)
  "tone": 0.3,             // InLocalToneStrength: how much it may change the local tones (light and shade)
  "structure": 0.7,        // InLocalStructureStrength: how much it may change the local structure (detail)
  "model": 0,              // InStyle: NVIDIA's model, 0 A, 1 B, 2 C
  "auto_mask": true,       // InUseAutoMask: DLSS-NR's own mask of the people, with the mask below (the lower of the two)
  "skin": 0.5,             // InSkinStructureStrength: the structure it may change on the people (with auto_mask)
  "sky": 1.0,              // the control mask on the sky (1: as the world; 0: the sky left as the game drew it)

  // Seeing the difference
  "split": false,          // the game's own frame left of the line, DLSS-NR's right of it
  "split_at": 0.5,         // where the line is (a share of the width)

  // Advanced
  "preset": 2,             // NVSDK_NGX_DLSSNR_Hint_Render_Preset at the feature's creation: 0 default, 1 A, 2 B (RTX Remix's)
  "sr_preset": 0,          // DLSS SR's render preset: 0 the DLL's own for each mode, 10 J, 11 K, 12 L, 13 M
  "jitter_sign": -1,       // the jitter as DLSS takes it (InJitterOffset): the inputs' sample offset times this
  "fg_stand_in": false,    // frame generation's showing tested on any GPU: the frames between two are the two blended
  "wait_ms": 250,          // how long a frame waits for the 64-bit half's answer at most (late frames show the game's)
  "messages": true,        // a line in the game's console when it is switched, and why it cannot run
  "debug": 0               // 0 DLSS-NR's picture; what it is given: 1 the motion vectors, 2 the depth, 3 the mask;
                           // 4 the round trip: DLSS-NR bypassed, the frame through the 64-bit half (and DLSS SR, when
                           // on) and back (any GPU);
                           // 5 the motion vectors checked: the frame before moved by them against this one (black where
                           // they are right), 6 the same without them (to compare)
}
