{
  // The defaults of bounce's settings (shipped with the mod; a deploy replaces this file in the game's folder).
  // Changes are kept in <game>\mml\data\bounce\config.json: the game's Options > Mods > Bounce, or
  // `config.set {"mod": "bounce", "key": "bpm", "value": 128}`.
  "on": true,
  "hotkey": "Shift+F7",
  "beat_hotkey": "Shift+F5",
  "bpm": 120,
  "amount": 0.2,        // squash: height * (1 + amount * c), width * (1 - amount * c), c from 1 on the beat to -1
  "size": 1,
  "shape": 3,           // 3 squash (tall and narrow, then low and wide; eased), 0 a kick, 1 a swell, 2 a hop (all three: every axis)
  "radius": 80,         // metres around the player (trams and trains: four times as far)
  "cars": true,
  "people": true,
  "pedestrians": true,
  "trains": true,
  "player": true
}
