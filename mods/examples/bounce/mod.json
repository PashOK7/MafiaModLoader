{
  "id": "bounce",
  "name": "Bounce: cars, people, trams and the traffic pulsing in size to a beat (actor_scale)",
  "version": "0.1.0",
  "type": "native",
  "entry": "bounce.dll",
  "enabled": false,
  "builds": ["1.2", "1.0"],
  "load_order": 100,
  "depends": [],
  "settings": {
    "title": "Bounce",
    "controls": [
      {"key": "on", "label": "Pulsing"},
      {"key": "hotkey", "label": "Pulsing on and off", "kind": "key"},
      {"key": "beat_hotkey", "label": "The beat starts now", "kind": "key"},
      {"key": "bpm", "label": "Beats a minute", "min": 40, "max": 240, "step": 1, "show": "value"},
      {"key": "amount", "label": "How far", "min": -0.6, "max": 0.6, "step": 0.05, "show": "value"},
      {"key": "size", "label": "Their size between beats", "min": 0.25, "max": 3, "step": 0.05, "show": "value"},
      {"key": "shape", "label": "The pulse", "options": [{"value": 3, "label": "Squash"}, {"value": 0, "label": "Kick"}, {"value": 1, "label": "Swell"}, {"value": 2, "label": "Hop"}]},
      {"key": "radius", "label": "How far around", "min": 10, "max": 300, "step": 10, "unit": "m"},
      {"key": "cars", "label": "Cars"},
      {"key": "people", "label": "People"},
      {"key": "pedestrians", "label": "The traffic's walkers"},
      {"key": "trains", "label": "Trams and trains"},
      {"key": "player", "label": "The player"}
    ]
  }
}
